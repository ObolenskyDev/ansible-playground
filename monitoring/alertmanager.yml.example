global:
  resolve_timeout: 5m

route:
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h
  receiver: 'telegram'

receivers:
  - name: 'telegram'
    telegram_configs:
      - bot_token: 'YOUR_BOT_TOKEN_HERE'
        chat_id: YOUR_CHAT_ID_HERE
        parse_mode: 'HTML'
        message: |
          {{ if eq .Status "firing" }}🔴 <b>{{ .CommonLabels.alertname }}</b> сработал{{ else }}✅ <b>{{ .CommonLabels.alertname }}</b> в норме{{ end }}
          {{ range .Alerts }}
          <b>Severity:</b> {{ .Labels.severity }}
          {{ if eq .Status "firing" }}<b>Проблема:</b> {{ .Annotations.description }}{{ else }}<b>Восстановлено:</b> проблема устранена, цель снова отвечает{{ end }}
          {{ end }}
